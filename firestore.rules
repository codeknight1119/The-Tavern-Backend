rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {
        match /users/{userId} {
            allow read: if request.auth != null;
            allow write: if request.auth != null &&
                         (request.auth.uid == userId ||
                          request.auth.token.officer == true);
        }

        // Shared application manifests and their timestamps.
        // Any authenticated Tavern user may update the timestamp because
        // client-side account creation uses it to invalidate the backend cache.
        match /manifest/{manifestId} {
            allow read, write: if request.auth != null;
        }

        match /features/{featureId} {
            allow read: if request.auth != null;
            allow write, delete: if request.auth != null &&
                                  request.auth.token.officer == true;

            match /messages/{messageId} {
                allow read: if request.auth != null;
                allow write: if request.auth != null;
            }

            match /boards/{boardId} {
                allow read: if request.auth != null;
                allow write: if request.auth != null;
            }

            match /tickets/{ticketId} {
                allow read: if request.auth != null &&
                            request.auth.token.officer == true;
                allow write: if request.auth != null;
            }
        }

        match /conversations/{allChildren=**} {
            allow read, write: if request.auth != null;
        }
    }
}
